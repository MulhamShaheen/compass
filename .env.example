# Copy to .env and fill in. Never commit .env.

# Supabase project (public values; safe in the browser). Also set both in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Migrations only (npm run db:migrate). Server side, never in Vercel.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_REGION=eu-west-2
SUPABASE_PASSWORD=<database password>
# Or instead of the three above: SUPABASE_DB_URL=postgresql://...

# Optional: run without Supabase or sign-in, on a local JSON file (used by the e2e tests).
# COMPASS_STORE=local
